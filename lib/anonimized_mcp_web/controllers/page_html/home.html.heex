<Layouts.app flash={@flash} current_user={@current_user}>
  <h1 id="home-title" class="text-2xl font-semibold">anonimized-mcp</h1>
  <p>
    Read-only SQL access to application databases for AI agents. Personal data in
    results is replaced by stable aliases before it leaves this server.
  </p>
  <p>
    Connect an MCP client to <code id="mcp-url" class="font-mono">{url(~p"/mcp")}</code>.
    It signs in through OAuth with an operator account.
  </p>
</Layouts.app>
